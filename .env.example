# Flask
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=replace-with-a-secure-random-secret-key

# Database
DATABASE_URL=sqlite:///alexore.db

# Site Identity
SITE_NAME=alexore
SITE_TAGLINE=Think Deeper. Write Better. Live Free.
SITE_AUTHOR=Alex Ore
SITE_DESCRIPTION=Personal essays, systems, and mental models.

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-secure-password

# Email (Resend)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev

# Social Channels (Optional)
