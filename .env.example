# Flask
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=replace-with-a-secure-random-secret-key

# Database
# Option A: Full connection string (overrides DB_* vars below if set)
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/dbname?charset=utf8mb4

# Option B: cPanel-style individual vars (recommended for shared hosting)
DB_USER=cpanel_db_username
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cpanel_db_name

# Site Identity
SITE_NAME=alexore
SITE_TAGLINE=Think Deeper. Write Better. Live Free.
SITE_AUTHOR=Alex Ore
SITE_DESCRIPTION=Personal essays, systems, and mental models.

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-secure-password

# Email (Resend)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev

# Social Channels (Optional)
TWITTER_URL=https://x.com/yourhandle
LINKEDIN_URL=https://linkedin.com/in/yourhandle
INSTAGRAM_URL=https://instagram.com/yourhandle
YOUTUBE_URL=
