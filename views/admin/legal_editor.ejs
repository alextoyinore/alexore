<%
  topbar_actions = `<a href="/${page.slug}" target="_blank" class="btn btn-ghost btn-sm" style="text-decoration:none !important;">View Live ↗</a>`;
%>

<div style="max-width: 960px;">

  <form method="POST" class="panel" style="padding: 32px;">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px; padding-bottom: 16px; border-bottom: 1px solid var(--border);">
      <div>
        <h3 style="margin: 0; font-size: 18px; color: var(--text);">Editing <%= page.title %></h3>
        <p style="margin: 4px 0 0; font-size: 12px; color: var(--text-muted);">
          URL: <a href="/<%= page.slug %>" target="_blank" style="color:var(--accent);">/<%= page.slug %></a>
        </p>
      </div>
      <a href="/admin/legal" class="btn btn-ghost btn-sm">← Back to Legal Pages</a>
    </div>

    <div class="form-group" style="margin-bottom: 24px;">
      <label class="form-label" for="title" style="font-weight: 700;">Page Title</label>
      <input 
        type="text" 
        id="title" 
        name="title" 
        class="form-control" 
        value="<%= page.title %>" 
        required
      >
    </div>

    <div class="form-group" style="margin-bottom: 28px;">
      <label class="form-label" for="content_html" style="font-weight: 700;">Page Content (Markdown &amp; HTML)</label>
      <p style="font-size: 12px; color: var(--text-muted); margin-top: 0; margin-bottom: 10px;">
        <strong>Supports both Markdown and HTML:</strong> write in standard Markdown (e.g. <code>## Heading</code>, <code>**bold**</code>, <code>* list</code>) or paste raw HTML.
      </p>
      <textarea 
        id="content_html" 
        name="content_html" 
        class="form-control" 
        rows="20" 
        style="resize: vertical; font-family: 'JetBrains Mono', 'Fira Code', monospace; font-size: 13px; line-height: 1.6;" 
        required
      ><%= page.content_html %></textarea>
    </div>

    <div style="display: flex; justify-content: space-between; align-items: center;">
      <a href="/admin/legal" class="btn btn-ghost">Cancel</a>
      <div style="display: flex; gap: 10px;">
        <a href="/<%= page.slug %>" target="_blank" class="btn btn-ghost">Preview Live ↗</a>
        <button type="submit" class="btn btn-primary" style="padding: 10px 24px;">Save Changes</button>
      </div>
    </div>
  </form>

</div>
