<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 28px; flex-wrap: wrap; gap: 16px;">
  <div>
    <h2 style="font-size: 1.5rem; font-weight: 700; margin-bottom: 4px;">Digital Products & Store</h2>
    <p style="color: var(--text-muted); font-size: 14px;">Manage digital books, courses, frameworks, and outbound store checkout links.</p>
  </div>
  <a href="/admin/products/new" class="btn btn-primary" style="display: inline-flex; align-items: center; gap: 6px; text-decoration: none;">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
    Add Digital Product
  </a>
</div>

<!-- Filters Bar -->
<div style="background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: 12px; padding: 14px 20px; margin-bottom: 24px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 14px;">
  <div style="display: flex; gap: 8px; align-items: center;">
    <span style="font-size: 13px; font-weight: 600; color: var(--text-secondary); margin-right: 6px;">Status:</span>
    <a href="/admin/products?status=all&category=<%= category_filter %>"
       class="btn btn-sm <%= status_filter === 'all' ? 'btn-primary' : 'btn-outline' %>" style="text-decoration: none;">All</a>
    <a href="/admin/products?status=published&category=<%= category_filter %>"
       class="btn btn-sm <%= status_filter === 'published' ? 'btn-primary' : 'btn-outline' %>" style="text-decoration: none;">Published</a>
    <a href="/admin/products?status=draft&category=<%= category_filter %>"
       class="btn btn-sm <%= status_filter === 'draft' ? 'btn-primary' : 'btn-outline' %>" style="text-decoration: none;">Drafts</a>
  </div>

  <div style="font-size: 13px; color: var(--text-muted);">
    Total Outbound Clicks: <strong style="color: var(--text-primary);"><%= totalClicks %></strong>
  </div>
</div>

<!-- Products Table -->
<div style="background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: 12px; overflow: hidden;">
  <% if (products && products.length > 0) { %>
    <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 14px;">
      <thead>
        <tr style="border-bottom: 1px solid var(--border-color); background: rgba(0,0,0,0.02); color: var(--text-muted); font-size: 12px; text-transform: uppercase; letter-spacing: 0.05em;">
          <th style="padding: 16px 20px;">Product</th>
          <th style="padding: 16px 20px;">Creator</th>
          <th style="padding: 16px 20px;">Category</th>
          <th style="padding: 16px 20px;">Price</th>
          <th style="padding: 16px 20px;">Store Link</th>
          <th style="padding: 16px 20px; text-align: center;">Clicks</th>
          <th style="padding: 16px 20px;">Status</th>
          <th style="padding: 16px 20px; text-align: right;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% products.forEach(product => { %>
          <tr style="border-bottom: 1px solid var(--border-color); transition: background 0.15s ease;" onmouseover="this.style.background='rgba(0,0,0,0.015)';" onmouseout="this.style.background='transparent';">
            <!-- Product Title & Thumbnail -->
            <td style="padding: 16px 20px;">
              <div style="display: flex; align-items: center; gap: 14px;">
                <div style="width: 52px; height: 38px; border-radius: 6px; overflow: hidden; background: var(--border-color); flex-shrink: 0;">
                  <% if (product.cover_image) { %>
                    <img src="<%= product.cover_image %>" alt="" style="width: 100%; height: 100%; object-fit: cover;">
                  <% } else { %>
                    <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 16px;">📦</div>
                  <% } %>
                </div>
                <div>
                  <a href="/admin/products/edit/<%= product.id %>" style="font-weight: 600; color: var(--text-primary); text-decoration: none;">
                    <%= product.title %>
                  </a>
                  <% if (product.featured) { %>
                    <span style="font-size: 10px; background: #eab308; color: #000; font-weight: 700; padding: 2px 6px; border-radius: 4px; margin-left: 6px;">FEATURED</span>
                  <% } %>
                  <div style="font-size: 12px; color: var(--text-muted);">/store/<%= product.slug %></div>
                </div>
              </div>
            </td>

            <!-- Creator -->
            <td style="padding: 16px 20px; font-weight: 500; color: var(--text-primary);">
              <%= product.creator_name %>
            </td>

            <!-- Category -->
            <td style="padding: 16px 20px;">
              <span style="font-size: 12px; background: rgba(0,0,0,0.05); padding: 4px 8px; border-radius: 6px;">
                <%= product.category || 'General' %>
              </span>
            </td>

            <!-- Price -->
            <td style="padding: 16px 20px; font-weight: 600;">
              <%= product.price %>
              <% if (product.original_price) { %>
                <span style="font-size: 12px; text-decoration: line-through; color: var(--text-muted); margin-left: 4px;">
                  <%= product.original_price %>
                </span>
              <% } %>
            </td>

            <!-- Store Destination -->
            <td style="padding: 16px 20px;">
              <a href="<%= product.external_store_url %>" target="_blank" rel="noopener noreferrer" style="display: inline-flex; align-items: center; gap: 4px; font-size: 13px; color: var(--accent); text-decoration: none;">
                <span><%= product.external_store_name %></span>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
              </a>
            </td>

            <!-- Clicks / Views -->
            <td style="padding: 16px 20px; text-align: center;">
              <span style="font-weight: 700; color: #10b981;"><%= product.clicks || 0 %></span>
              <span style="font-size: 11px; color: var(--text-muted);"> (<%= product.views || 0 %> views)</span>
            </td>

            <!-- Status -->
            <td style="padding: 16px 20px;">
              <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; padding: 4px 8px; border-radius: 6px; <%= product.status === 'published' ? 'background: rgba(16, 185, 129, 0.12); color: #10b981;' : 'background: rgba(100, 116, 139, 0.12); color: #64748b;' %>">
                <%= product.status %>
              </span>
            </td>

            <!-- Actions -->
            <td style="padding: 16px 20px; text-align: right;">
              <div style="display: flex; justify-content: flex-end; gap: 8px;">
                <a href="/store/<%= product.slug %>" target="_blank" class="btn btn-sm btn-outline" style="text-decoration: none;" title="View on Live Store">
                  View
                </a>
                <a href="/admin/products/edit/<%= product.id %>" class="btn btn-sm btn-outline" style="text-decoration: none;" title="Edit Product">
                  Edit
                </a>
                <a href="/admin/products/delete/<%= product.id %>" class="btn btn-sm" style="color: var(--danger); text-decoration: none; border: 1px solid rgba(239, 68, 68, 0.3);"
                   onclick="return confirm('Are you sure you want to delete <%= product.title %>?');">
                  Delete
                </a>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } else { %>
    <div style="text-align: center; padding: 64px 20px;">
      <div style="font-size: 2.5rem; margin-bottom: 12px;">🛍️</div>
      <h3 style="font-size: 1.25rem; font-weight: 600; margin-bottom: 8px;">No Digital Products Yet</h3>
      <p style="color: var(--text-muted); font-size: 14px; margin-bottom: 20px;">Upload your first digital product or framework to publish on the storefront.</p>
      <a href="/admin/products/new" class="btn btn-primary" style="text-decoration: none;">Add Your First Product</a>
    </div>
  <% } %>
</div>
