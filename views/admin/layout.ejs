<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' && title ? `${title} — ${SITE_NAME}` : `Admin — ${SITE_NAME}` %></title>
  <script>
    (function() {
      try {
        var t = localStorage.getItem('alexore_theme') || 'system';
        var dark = t === 'dark' || (t === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
        document.documentElement.setAttribute('data-color-scheme', t);
      } catch(e) {}
    })();
  </script>
  <link rel="stylesheet" href="/static/css/admin.css">
  <link rel="stylesheet" href="/static/css/style.css">
  <%- typeof extra_css !== 'undefined' ? extra_css : '' %>
</head>
<body>

  <!-- Flash Messages -->
  <% const flashedMessages = get_flashed_messages({ with_categories: true }); %>
  <% if (flashedMessages && flashedMessages.length > 0) { %>
    <div class="flash-messages">
      <% flashedMessages.forEach(([cat, msg]) => { %>
        <div class="flash flash-<%= cat %>"><%= msg %></div>
      <% }) %>
    </div>
    <script>
      setTimeout(() => {
        const flashes = document.querySelectorAll('.flash-messages');
        flashes.forEach(f => f.style.display = 'none');
      }, 5000);
    </script>
  <% } %>

  <div class="admin-layout">
    <div class="sidebar-backdrop"></div>

    <!-- Sidebar -->
    <aside class="sidebar">
      <div class="sidebar-logo">
        <a href="/admin"><%= SITE_NAME %></a>
        <span>Control Panel</span>
      </div>

      <nav class="sidebar-nav">
        <div class="sidebar-section">
          <div class="sidebar-section-label">Overview</div>
          <a href="/admin" class="sidebar-link <%= request.path === '/admin' ? 'active' : '' %>">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
            Dashboard
          </a>
        </div>

        <div class="sidebar-section">
          <div class="sidebar-section-label">Content</div>
          <a href="/admin/posts" class="sidebar-link <%= request.path === '/admin/posts' || request.path.startsWith('/admin/edit') ? 'active' : '' %>">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
            All Posts
          </a>
          <a href="/admin/new" class="sidebar-link <%= request.path === '/admin/new' ? 'active' : '' %>">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Write Essay
          </a>
          <a href="/admin/products" class="sidebar-link <%= request.path.startsWith('/admin/products') ? 'active' : '' %>">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
            Digital Products
          </a>
          <a href="/admin/topics" class="sidebar-link <%= request.path.startsWith('/admin/topics') ? 'active' : '' %>">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
            Topics
          </a>
          <a href="/admin/about" class="sidebar-link <%= request.path === '/admin/about' ? 'active' : '' %>">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            About Me
          </a>
          <a href="/admin/resources" class="sidebar-link <%= request.path.startsWith('/admin/resources') ? 'active' : '' %>">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
            Resources
          </a>
        </div>

        <div class="sidebar-section">
          <div class="sidebar-section-label">Audience</div>
          <a href="/admin/comments" class="sidebar-link <%= request.path === '/admin/comments' ? 'active' : '' %>">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            Comments
            <% if (typeof pending_comments_count !== 'undefined' && pending_comments_count > 0) { %>
              <span style="margin-left: auto; background: #eab308; color: #000; font-size: 10px; font-weight: 800; padding: 2px 7px; border-radius: 100px;">
                <%= pending_comments_count %>
              </span>
            <% } %>
          </a>
          <a href="/admin/subscribers" class="sidebar-link <%= request.path === '/admin/subscribers' ? 'active' : '' %>">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            Subscribers
          </a>
          <a href="/admin/send-email" class="sidebar-link <%= request.path === '/admin/send-email' ? 'active' : '' %>">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            Send Newsletter
          </a>
        </div>

        <div class="sidebar-section">
          <div class="sidebar-section-label">System</div>
          <a href="/admin/legal" class="sidebar-link <%= request.path.startsWith('/admin/legal') ? 'active' : '' %>">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
            Legal Pages
          </a>
          <a href="/admin/settings" class="sidebar-link <%= request.path === '/admin/settings' ? 'active' : '' %>">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
            Settings
          </a>
        </div>
      </nav>

      <div class="sidebar-footer">
        <a href="/" target="_blank" class="sidebar-link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          View Live Site
        </a>
        <a href="/auth/logout" class="sidebar-link" style="color: var(--danger);">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          Sign Out
        </a>
      </div>
    </aside>

    <!-- Main Content Area -->
    <main class="admin-main">
      <header class="admin-topbar">
        <div class="admin-topbar-left">
          <button class="sidebar-toggle-btn" id="admin-sidebar-toggle" aria-label="Toggle navigation drawer">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
          </button>
          <h1 class="admin-topbar-title"><%= typeof page_title !== 'undefined' ? page_title : (typeof title !== 'undefined' ? title : 'Admin Panel') %></h1>
        </div>

        <%- typeof topbar_toolbar !== 'undefined' ? topbar_toolbar : '' %>

        <div class="admin-topbar-actions">
          <div class="theme-switcher">
            <button class="theme-switcher-btn" type="button" aria-label="Toggle theme" title="Switch theme">
              <svg class="theme-icon theme-icon-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
              <svg class="theme-icon theme-icon-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
              <svg class="theme-icon theme-icon-system" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
            </button>
            <div class="theme-dropdown">
              <button type="button" class="theme-opt" data-theme-val="light">Light</button>
              <button type="button" class="theme-opt" data-theme-val="dark">Dark</button>
              <button type="button" class="theme-opt" data-theme-val="system">System</button>
            </div>
          </div>
          <%- typeof topbar_actions !== 'undefined' ? topbar_actions : `
            <div style="display:flex; gap: 8px;">
              <a href="/admin/products/new" class="btn btn-outline btn-sm">+ Product</a>
              <a href="/admin/new" class="btn btn-primary btn-sm">+ Essay</a>
            </div>
          ` %>
        </div>
      </header>

      <div class="admin-content">
        <%- body %>
      </div>
    </main>
  </div>

  <script src="/static/js/main.js"></script>
  <%- typeof extra_js !== 'undefined' ? extra_js : '' %>
</body>
</html>
