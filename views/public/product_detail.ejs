<div class="container" style="max-width: 1140px; margin: 0 auto; padding: 40px 24px 96px;">
  <!-- Breadcrumbs -->
  <nav style="font-size: 13px; color: var(--text-muted); margin-bottom: 32px; display: flex; align-items: center; gap: 8px;">
    <a href="/store" style="color: var(--text-secondary); text-decoration: none;">Store</a>
    <span>/</span>
    <% if (product.category) { %>
      <a href="/store?category=<%= encodeURIComponent(product.category) %>" style="color: var(--text-secondary); text-decoration: none;"><%= product.category %></a>
      <span>/</span>
    <% } %>
    <span style="color: var(--text-primary);"><%= product.title %></span>
  </nav>

  <!-- Product Hero & Purchase Area -->
  <div style="display: grid; grid-template-columns: 1fr; gap: 48px; margin-bottom: 64px;" class="product-layout-grid">
    <style>
      @media (min-width: 860px) {
        .product-layout-grid {
          grid-template-columns: 460px 1fr !important;
          align-items: start;
        }
      }
    </style>

    <!-- Left Column: Visual Presentation & Buy Box -->
    <div>
      <div style="position: sticky; top: 100px;">
        <!-- Cover Mockup -->
        <div style="background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: 16px; overflow: hidden; margin-bottom: 24px; box-shadow: 0 10px 30px rgba(0,0,0,0.06);">
          <% if (product.cover_image) { %>
            <img src="<%= product.cover_image %>" alt="<%= product.cover_image_alt || product.title %>"
                 style="width: 100%; aspect-ratio: 16/11; object-fit: cover; display: block;">
          <% } else { %>
            <div style="width: 100%; aspect-ratio: 16/11; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, rgba(200,100,50,0.08), rgba(50,150,200,0.08));">
              <span style="font-size: 4rem;">📦</span>
            </div>
          <% } %>
        </div>

        <!-- Buy Action Box -->
        <div style="background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: 16px; padding: 24px; box-shadow: 0 4px 16px rgba(0,0,0,0.03);">
          <!-- Price and Discount -->
          <div style="display: flex; align-items: baseline; gap: 12px; margin-bottom: 12px;">
            <span style="font-size: 2.2rem; font-weight: 700; color: var(--text-primary); font-family: Georgia, serif;">
              <%= product.price %>
            </span>
            <% if (product.original_price) { %>
              <span style="font-size: 1.2rem; text-decoration: line-through; color: var(--text-muted);">
                <%= product.original_price %>
              </span>
              <span style="font-size: 12px; font-weight: 700; background: rgba(16, 185, 129, 0.12); color: #10b981; padding: 3px 8px; border-radius: 4px;">
                SAVE
              </span>
            <% } %>
          </div>

          <p style="font-size: 13px; color: var(--text-muted); margin-bottom: 20px;">
            Instant digital access via <%= product.external_store_name %>. No physical shipment required.
          </p>

          <!-- Primary CTA Button -->
          <a href="/store/<%= product.slug %>/buy" target="_blank" rel="noopener noreferrer"
             style="display: flex; align-items: center; justify-content: center; gap: 10px; width: 100%; padding: 16px 24px; border-radius: 10px; font-size: 1.05rem; font-weight: 700; text-decoration: none; background: var(--accent); color: #fff; text-align: center; box-shadow: 0 4px 14px rgba(0,0,0,0.15); transition: transform 0.15s ease, opacity 0.15s ease;"
             onmouseover="this.style.opacity='0.92'; this.style.transform='translateY(-1px)';"
             onmouseout="this.style.opacity='1'; this.style.transform='none';">
            <span>Buy on <%= product.external_store_name %></span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
          </a>

          <!-- Guarantee / Store Trust notes -->
          <div style="margin-top: 20px; padding-top: 16px; border-top: 1px solid var(--border-color); display: flex; flex-direction: column; gap: 8px; font-size: 12px; color: var(--text-muted);">
            <div style="display: flex; align-items: center; gap: 8px;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              <span>Secure checkout powered by <%= product.external_store_name %></span>
            </div>
            <div style="display: flex; align-items: center; gap: 8px;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Instant download link sent directly to your email</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column: Product Narrative & Content -->
    <div>
      <!-- Badges -->
      <div style="display: flex; gap: 10px; align-items: center; margin-bottom: 16px; flex-wrap: wrap;">
        <% if (product.badge) { %>
          <span style="background: #111; color: #fff; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; padding: 4px 10px; border-radius: 6px;">
            <%= product.badge %>
          </span>
        <% } %>
        <% if (product.category) { %>
          <span style="background: var(--bg-surface); border: 1px solid var(--border-color); font-size: 12px; font-weight: 600; padding: 4px 10px; border-radius: 6px; color: var(--text-secondary);">
            <%= product.category %>
          </span>
        <% } %>
      </div>

      <!-- Title & Subtitle -->
      <h1 style="font-family: Georgia, serif; font-size: 2.6rem; font-weight: 400; line-height: 1.25; margin-bottom: 16px; color: var(--text-primary);">
        <%= product.title %>
      </h1>

      <% if (product.subtitle) { %>
        <p style="font-size: 1.2rem; line-height: 1.6; color: var(--text-secondary); margin-bottom: 24px;">
          <%= product.subtitle %>
        </p>
      <% } %>

      <!-- Creator Spotlight Pill -->
      <div style="display: flex; align-items: center; gap: 14px; padding: 14px 18px; background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: 12px; margin-bottom: 36px; max-width: 520px;">
        <div style="width: 44px; height: 44px; border-radius: 50%; background: var(--border-color); display: flex; align-items: center; justify-content: center; font-size: 18px; font-weight: 700; color: var(--text-primary); flex-shrink: 0;">
          <%= product.creator_name.charAt(0) %>
        </div>
        <div>
          <div style="font-size: 14px; font-weight: 700; color: var(--text-primary);">
            Created by <%= product.creator_name %>
          </div>
          <% if (product.creator_bio) { %>
            <div style="font-size: 12px; color: var(--text-secondary); line-height: 1.4;">
              <%= product.creator_bio %>
            </div>
          <% } else { %>
            <div style="font-size: 12px; color: var(--text-muted);">
              Published on the <%= SITE_NAME %> platform
            </div>
          <% } %>
        </div>
      </div>

      <!-- Full Product Description Content -->
      <div class="product-description" style="font-size: 1.05rem; line-height: 1.8; color: var(--text-primary);">
        <%- product.content_html || '<p>No description provided for this item.</p>' %>
      </div>
    </div>
  </div>

  <!-- Related Products Section -->
  <% if (related && related.length > 0) { %>
    <section style="margin-top: 80px; padding-top: 48px; border-top: 1px solid var(--border-color);">
      <h3 style="font-family: Georgia, serif; font-size: 1.8rem; margin-bottom: 32px; color: var(--text-primary);">
        More Digital Resources
      </h3>
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 24px;">
        <% related.forEach(rel => { %>
          <div style="background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: 12px; overflow: hidden; padding: 20px; display: flex; flex-direction: column;">
            <div style="font-size: 12px; color: var(--text-muted); margin-bottom: 6px;">By <%= rel.creator_name %></div>
            <h4 style="font-family: Georgia, serif; font-size: 1.15rem; margin-bottom: 8px;">
              <a href="/store/<%= rel.slug %>" style="color: var(--text-primary); text-decoration: none;">
                <%= rel.title %>
              </a>
            </h4>
            <div style="margin-top: auto; padding-top: 12px; display: flex; align-items: center; justify-content: space-between;">
              <span style="font-weight: 700; color: var(--text-primary);"><%= rel.price %></span>
              <a href="/store/<%= rel.slug %>" style="font-size: 13px; color: var(--accent); text-decoration: none; font-weight: 600;">View &rarr;</a>
            </div>
          </div>
        <% }) %>
      </div>
    </section>
  <% } %>
</div>
