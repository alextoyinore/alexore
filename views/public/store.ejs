<div class="container" style="max-width: 1140px; margin: 0 auto; padding: 48px 24px 96px;">
  <!-- Store Header -->
  <header style="text-align: center; max-width: 680px; margin: 0 auto 56px;">
    <span style="display: inline-block; font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; color: var(--accent); margin-bottom: 12px;">Digital Library</span>
    <h1 style="font-family: Georgia, serif; font-size: 2.8rem; font-weight: 400; line-height: 1.2; margin-bottom: 16px; color: var(--text-primary);">
      Books, Frameworks & Toolkits
    </h1>
    <p style="font-size: 1.125rem; line-height: 1.7; color: var(--text-secondary);">
      Curated digital resources, playbooks, and educational systems created by <%= SITE_AUTHOR %> and select independent partners.
    </p>
  </header>

  <!-- Category Filters -->
  <% if (categories && categories.length > 0) { %>
    <div style="display: flex; justify-content: center; gap: 10px; margin-bottom: 48px; flex-wrap: wrap;">
      <a href="/store"
         style="display: inline-block; padding: 8px 18px; border-radius: 100px; font-size: 14px; font-weight: 500; text-decoration: none; transition: all 0.2s ease;
         <%= category_filter === 'all' ? 'background: var(--text-primary); color: var(--bg-primary);' : 'background: var(--bg-surface); color: var(--text-secondary); border: 1px solid var(--border-color);' %>">
        All Items
      </a>
      <% categories.forEach(cat => { %>
        <a href="/store?category=<%= encodeURIComponent(cat) %>"
           style="display: inline-block; padding: 8px 18px; border-radius: 100px; font-size: 14px; font-weight: 500; text-decoration: none; transition: all 0.2s ease;
           <%= category_filter === cat ? 'background: var(--text-primary); color: var(--bg-primary);' : 'background: var(--bg-surface); color: var(--text-secondary); border: 1px solid var(--border-color);' %>">
          <%= cat %>
        </a>
      <% }) %>
    </div>
  <% } %>

  <!-- Products Grid -->
  <% if (products && products.length > 0) { %>
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 36px;">
      <% products.forEach(product => { %>
        <article style="background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: 16px; overflow: hidden; display: flex; flex-direction: column; transition: transform 0.2s ease, box-shadow 0.2s ease; box-shadow: 0 4px 20px rgba(0,0,0,0.03);"
                 onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 12px 28px rgba(0,0,0,0.08)';"
                 onmouseout="this.style.transform='none'; this.style.boxShadow='0 4px 20px rgba(0,0,0,0.03)';">

          <!-- Cover Image Area -->
          <a href="/store/<%= product.slug %>" style="display: block; position: relative; width: 100%; aspect-ratio: 16/10; background: var(--border-color); overflow: hidden; text-decoration: none;">
            <% if (product.cover_image) { %>
              <img src="<%= product.cover_image %>" alt="<%= product.cover_image_alt || product.title %>"
                   style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease;"
                   onmouseover="this.style.transform='scale(1.03)';"
                   onmouseout="this.style.transform='none';">
            <% } else { %>
              <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, rgba(200,100,50,0.08), rgba(50,150,200,0.08));">
                <span style="font-size: 3rem;">📦</span>
              </div>
            <% } %>

            <!-- Badge Overlay -->
            <div style="position: absolute; top: 14px; left: 14px; display: flex; gap: 8px; flex-wrap: wrap;">
              <% if (product.badge) { %>
                <span style="background: #111; color: #fff; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; padding: 4px 10px; border-radius: 6px; box-shadow: 0 2px 6px rgba(0,0,0,0.2);">
                  <%= product.badge %>
                </span>
              <% } %>
              <% if (product.category) { %>
                <span style="background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(4px); color: #111; font-size: 11px; font-weight: 600; padding: 4px 10px; border-radius: 6px;">
                  <%= product.category %>
                </span>
              <% } %>
            </div>
          </a>

          <!-- Content Details -->
          <div style="padding: 24px; display: flex; flex-direction: column; flex-grow: 1;">
            <div style="font-size: 13px; font-weight: 600; color: var(--text-muted); margin-bottom: 8px; display: flex; align-items: center; gap: 6px;">
              <span>By <%= product.creator_name %></span>
              <% if (product.creator_name !== SITE_AUTHOR) { %>
                <span style="font-size: 10px; background: rgba(0,0,0,0.06); padding: 2px 6px; border-radius: 4px; text-transform: uppercase; letter-spacing: 0.05em;">Partner</span>
              <% } %>
            </div>

            <h2 style="font-family: Georgia, serif; font-size: 1.35rem; font-weight: 600; line-height: 1.35; margin: 0 0 10px;">
              <a href="/store/<%= product.slug %>" style="color: var(--text-primary); text-decoration: none;">
                <%= product.title %>
              </a>
            </h2>

            <% if (product.subtitle) { %>
              <p style="font-size: 0.95rem; line-height: 1.6; color: var(--text-secondary); margin: 0 0 20px; flex-grow: 1;">
                <%= product.subtitle %>
              </p>
            <% } %>

            <!-- Pricing & External Platform Badge -->
            <div style="margin-top: auto; padding-top: 16px; border-top: 1px solid var(--border-color); display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px;">
              <div>
                <span style="font-size: 1.3rem; font-weight: 700; color: var(--text-primary);">
                  <%= product.price %>
                </span>
                <% if (product.original_price) { %>
                  <span style="font-size: 0.95rem; text-decoration: line-through; color: var(--text-muted); margin-left: 8px;">
                    <%= product.original_price %>
                  </span>
                <% } %>
              </div>
              <span style="font-size: 12px; color: var(--text-muted); display: inline-flex; align-items: center; gap: 4px;">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                On <%= product.external_store_name %>
              </span>
            </div>

            <!-- Action Buttons -->
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
              <a href="/store/<%= product.slug %>"
                 style="display: inline-flex; align-items: center; justify-content: center; padding: 10px 14px; border-radius: 8px; font-size: 14px; font-weight: 500; text-decoration: none; border: 1px solid var(--border-color); background: transparent; color: var(--text-primary); text-align: center; transition: all 0.2s;">
                View Details
              </a>
              <a href="/store/<%= product.slug %>/buy" target="_blank" rel="noopener noreferrer"
                 style="display: inline-flex; align-items: center; justify-content: center; gap: 6px; padding: 10px 14px; border-radius: 8px; font-size: 14px; font-weight: 600; text-decoration: none; background: var(--accent); color: #fff; text-align: center; transition: opacity 0.2s;"
                 onmouseover="this.style.opacity='0.9';"
                 onmouseout="this.style.opacity='1';">
                <span>Buy Now</span>
                <span style="font-size: 16px;">&nearr;</span>
              </a>
            </div>
          </div>
        </article>
      <% }) %>
    </div>
  <% } else { %>
    <!-- Empty State -->
    <div style="text-align: center; padding: 80px 24px; background: var(--bg-surface); border: 1px dashed var(--border-color); border-radius: 16px; max-width: 540px; margin: 0 auto;">
      <div style="font-size: 3rem; margin-bottom: 16px;">📚</div>
      <h3 style="font-family: Georgia, serif; font-size: 1.5rem; margin-bottom: 8px; color: var(--text-primary);">No products in this category yet</h3>
      <p style="color: var(--text-secondary); margin-bottom: 24px;">New digital products and guides are regularly released. Check back soon or view all items.</p>
      <a href="/store" class="btn btn-outline" style="text-decoration: none;">View All Products</a>
    </div>
  <% } %>
</div>
