<section class="section container" style="padding-top: 140px; padding-bottom: 120px; text-align: center;">
  <div style="max-width: 540px; margin: 0 auto; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 48px 32px;">
    <div style="font-size: 40px; margin-bottom: 16px;">👋</div>
    <h1 style="font-size: 28px; font-weight: 800; margin-bottom: 12px; color: var(--text);">You've been unsubscribed</h1>
    <p style="font-size: 15px; color: var(--text-muted); line-height: 1.6; margin-bottom: 32px;">
      <strong><%= subscriber ? subscriber.email : 'Your email' %></strong> has been removed from our active subscriber list. You will not receive future issues.
    </p>
    <a href="/" class="btn btn-outline" style="text-decoration: none;">Return to Homepage</a>
  </div>
</section>
