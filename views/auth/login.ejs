<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Login — <%= SITE_NAME %></title>
  <link rel="stylesheet" href="/static/css/admin.css">
  <style>
    body {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      background: #080809;
    }
    .login-box {
      width: 100%;
      max-width: 380px;
      padding: 40px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
    }
  </style>
</head>
<body>
  <div class="login-box">
    <div style="text-align: center; margin-bottom: 32px;">
      <h1 style="font-family: 'Syne', sans-serif; font-size: 20px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase;"><%= SITE_NAME %></h1>
      <span style="font-size: 11px; color: var(--text-muted); letter-spacing: 0.1em; text-transform: uppercase;">Control Panel</span>
    </div>

    <% const flashList = get_flashed_messages({ with_categories: true }); %>
    <% if (flashList && flashList.length > 0) { %>
      <% flashList.forEach(([category, message]) => { %>
        <div class="flash flash-<%= category %>" style="position:static; margin-bottom: 20px;"><%= message %></div>
      <% }) %>
    <% } %>

    <form method="POST" action="/auth/login">
      <div class="form-group">
        <label class="form-label">Username</label>
        <input type="text" name="username" class="form-control" required autofocus placeholder="admin">
      </div>

      <div class="form-group" style="margin-bottom: 28px;">
        <label class="form-label">Password</label>
        <input type="password" name="password" class="form-control" required placeholder="••••••••">
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%; justify-content: center; padding: 12px;">Sign In</button>
    </form>
  </div>
</body>
</html>
